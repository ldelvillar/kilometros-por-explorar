# Endpoints used by the contact form and the chatbot island.
# Copy this file to `.env` and fill in the real values.
# In production they live in Vercel > Settings > Environment Variables.
#
# Both are required: `astro build` fails if either is missing (see the `env`
# schema in astro.config.mjs). Being PUBLIC_, they are inlined into the client
# bundle and visible to anyone — never put a secret here.

# Receives the contact form submissions as a JSON POST. Points at the
# backend's /contact route (rate-limited), not directly at the Make.com
# webhook — that URL is a backend-only secret (CONTACT_WEBHOOK_URL).
PUBLIC_CONTACT_FORM_ENDPOINT=https://example.com/contact

# Receives the chatbot messages as a JSON POST and answers with { message: string }.
PUBLIC_CHATBOT_WEBHOOK_ENDPOINT=https://example.com/chatbot-webhook
