---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import FeaturedCustomerCard from '@/components/customers/FeaturedCustomerCard.astro';
import CustomerCard from '@/components/customers/CustomerCard.astro';
import PageTitle from '@/components/PageTitle.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  getWebPageSchema,
  getCombinedSchema,
  getBreadcrumbSchema,
  getItemListSchema,
  type BreadcrumbItem,
} from '@/config/schemas';
import { getPageTitle } from '@/utils/getPageTitle';

const title = getPageTitle('Historias de Viajeros Satisfechos');
const description =
  'Experiencias reales de viajeros que planificaron su viaje con nosotros. Descubre sus historias y déjate inspirar para tu próxima aventura.';
const pathname = Astro.url.pathname;

const customers = await getCollection('customers');
const featuredCustomers = customers.filter(customer => customer.data.featured);
const otherCustomers = customers.filter(customer => !customer.data.featured);

const breadcrumbItems: BreadcrumbItem[] = [
  { name: 'Inicio', href: '/' },
  { name: 'Viajeros' },
];

const pageSchema = getWebPageSchema(
  title,
  description,
  pathname,
  true,
  'CollectionPage'
);
const schema = getCombinedSchema(
  pageSchema,
  getBreadcrumbSchema(breadcrumbItems, pathname),
  getItemListSchema(
    [...featuredCustomers, ...otherCustomers].map(customer => ({
      name: customer.data.name,
      href: `/viajeros/${customer.id}`,
    })),
    pathname
  )
);
---

<Layout title={title} description={description} schema={schema}>
  <main id="main" class="animate-fade-in-up">
    <section class="mx-auto max-w-7xl px-4 pt-28 pb-6 md:pt-36 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} class="mb-6" />

      <PageTitle
        eyebrow="Historias reales"
        title="Viajeros satisfechos"
        class="mb-5"
      />
      <p
        class="mx-auto mb-8 max-w-[640px] text-center text-lg leading-relaxed text-gray-600"
      >
        Conoce historias de viajeros que han encontrado su destino ideal gracias
        a Kilómetros por Explorar.
      </p>

      <h2 class="sr-only">Viajeros destacados</h2>

      <div
        class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-14 lg:grid-cols-3"
      >
        {
          featuredCustomers.map(customer => (
            <FeaturedCustomerCard customer={customer} loading="eager" />
          ))
        }
      </div>
    </section>

    {
      otherCustomers.length > 0 && (
        <section class="mx-auto max-w-7xl px-4 pt-16 pb-6 lg:px-8">
          <div class="mb-6">
            <SectionHeading
              eyebrow="Otros viajeros"
              title="Más historias"
              class="mb-3.5"
            />
          </div>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-14 lg:grid-cols-3">
            {otherCustomers.map(customer => (
              <CustomerCard customer={customer} loading="lazy" />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
