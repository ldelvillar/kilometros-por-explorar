---
import Layout from '@/layouts/Layout.astro';
import InteractiveDestinations from '@/components/destinations/InteractiveDestinations.astro';
import Cta from '@/components/Cta.astro';
import PageTitle from '@/components/PageTitle.astro';
import SearchBar from '@/components/SearchBar.astro';

import { getWebPageSchema, getCombinedSchema } from '@/config/schemas';
import { getCollection } from 'astro:content';
import { getPageTitle } from '@/utils/getPageTitle';

const title = getPageTitle('Destinos de Viaje');
const description =
  'Descubre nuestros destinos cuidadosamente seleccionados. Desde playas paradisíacas hasta aventuras culturales, encuentra tu próxima experiencia de viaje.';
const pathname = Astro.url.pathname;

const pageSchema = getWebPageSchema(title, description, pathname);
const schema = getCombinedSchema(pageSchema);

const allDestinations = await getCollection('destinations');

const categories = [
  {
    id: 'all',
    label: 'Todos',
    count: allDestinations.length,
  },
  {
    id: 'cultural',
    label: 'Culturales',
    count: allDestinations.filter(d => d.data.category === 'cultural').length,
  },
  {
    id: 'playa',
    label: 'Playa',
    count: allDestinations.filter(d => d.data.category === 'playa').length,
  },
  {
    id: 'naturaleza',
    label: 'Naturaleza',
    count: allDestinations.filter(d => d.data.category === 'naturaleza').length,
  },
  {
    id: 'barco',
    label: 'Barco',
    count: allDestinations.filter(d => d.data.category === 'barco').length,
  },
  {
    id: 'ciudad',
    label: 'Ciudades',
    count: allDestinations.filter(d => d.data.category === 'ciudad').length,
  },
  {
    id: 'sorpresa',
    label: 'Sorpresa',
    count: allDestinations.filter(d => d.data.category === 'sorpresa').length,
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <main id="main" class="animate-fade-in-up min-h-screen">
    <section class="mx-auto max-w-7xl px-4 pt-32 pb-8">
      <div class="mx-auto max-w-[760px] text-center">
        <PageTitle
          as="h1"
          eyebrow="Explora nuestros destinos"
          title="¿A dónde quieres ir?"
          class="mb-7"
        />

        <SearchBar
          id="hero-search"
          buttonId="hero-search-btn"
          placeholder="Busca un país, ciudad o experiencia..."
          label="Buscar destinos"
          class="mb-6"
        />

        <div class="flex flex-wrap justify-center gap-2.5">
          {
            categories.map(cat => (
              <button
                type="button"
                class="hero-chip inline-flex cursor-pointer items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-[9px] text-sm font-bold text-gray-800 transition-all duration-150 hover:border-primary hover:text-primary"
                data-category={cat.id}
                data-active={cat.id === 'all' ? 'true' : 'false'}
              >
                {cat.label}
                <span class="text-xs font-extrabold text-gray-400">
                  {cat.count}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <InteractiveDestinations />
    <div id="destinos-cta">
      <Cta />
    </div>
  </main>
</Layout>

<style>
  .hero-chip[data-active='true'] {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .hero-chip[data-active='true']:hover {
    color: white;
  }

  .hero-chip[data-active='true'] span {
    color: rgba(255, 255, 255, 0.85);
  }
</style>

<script>
  // Hide the CTA while the search shows its empty state (mirrors the design).
  document.addEventListener('destinos:emptychange', event => {
    const cta = document.getElementById('destinos-cta');
    if (cta)
      cta.hidden = (event as CustomEvent<{ empty: boolean }>).detail.empty;
  });
</script>
