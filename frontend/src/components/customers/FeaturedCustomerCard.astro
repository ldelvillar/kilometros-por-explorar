---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import ArrowLink from '@/components/ArrowLink.astro';

interface Props {
  customer: CollectionEntry<'customers'>;
  loading?: 'eager' | 'lazy';
}

const { customer, loading } = Astro.props;

const destination = await getEntry(customer.data.destination);
---

<article class="group h-full">
  <a
    href={`/viajeros/${customer.id}`}
    class="flex h-full flex-col overflow-hidden bg-white"
  >
    {/* Image Container */}
    <div class="relative h-[420px] overflow-hidden rounded-lg md:h-[475px]">
      <Image
        src={customer.data.image}
        widths={[600, 800, 1024]}
        sizes="640px"
        alt={`Historia de éxito de ${customer.data.name}`}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
        loading={loading}
      />

      {/* Overlay */}
      <div class="absolute inset-0 bg-black/20"></div>

      {/* Company Logo */}
      <div class="absolute top-4 left-4 z-10">
        <div class="rounded-lg bg-white/90 p-2 shadow-lg backdrop-blur-sm">
          <img
            src={customer.data.destinationFlagImage.src}
            width={80}
            height={40}
            alt={`Bandera de ${destination.data.name}`}
            class="h-8 w-auto object-contain"
            loading={loading}
          />
        </div>
      </div>

      {/* Company Name Overlay */}
      <div class="absolute bottom-4 left-4 z-10">
        <h3 class="text-lg font-bold text-white lg:text-xl">
          {customer.data.name}
        </h3>
      </div>
    </div>

    {/* Content */}
    <div class="flex flex-1 flex-col pt-8 pb-1">
      <p
        class="mb-6 line-clamp-4 flex-1 text-xl leading-tight font-semibold text-gray-900"
      >
        {customer.data.title}
      </p>

      <ArrowLink class="mt-auto">
        <span class="animated-underline relative">Ver historia completa</span>
      </ArrowLink>
    </div>
  </a>
</article>
