---
import { SITE_CONFIG } from '@/config/site';

interface InputsData {
  question: string;
  type: 'text' | 'email' | 'tel' | 'textarea';
  id: string;
  placeholder: string;
  pattern?: string;
  title?: string;
  required: boolean;
}

const INPUTS: InputsData[] = [
  {
    question: 'Nombre*',
    type: 'text',
    id: 'name',
    placeholder: 'Introduce tu nombre',
    required: true,
  },
  {
    question: 'Apellido',
    type: 'text',
    id: 'surname',
    placeholder: 'Introduce tu apellido',
    required: false,
  },
  {
    question: 'Email*',
    type: 'email',
    id: 'email',
    placeholder: 'Introduce tu email',
    required: true,
  },
  {
    question: 'Teléfono',
    type: 'tel',
    id: 'phone',
    placeholder: 'Introduce tu teléfono',
    pattern: String.raw`^(\+?\d{1,3}\s*)?(\s*\d\s*){9}$`,
    title:
      '9 dígitos, con prefijo internacional opcional. Ej.: +34 604 11 26 28',
    required: false,
  },
];

const { company } = SITE_CONFIG;
---

<form class="space-y-6" autocomplete="on" data-contact-form>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      INPUTS.map(input => (
        <div
          class={`text-gray-900 ${input.type === 'textarea' ? 'col-span-full' : ''}`}
        >
          <label
            for={input.id}
            class="mb-2 block text-xl font-bold text-primary"
          >
            {input.question}
          </label>

          <input
            type={input.type}
            id={input.id}
            name={input.id}
            placeholder={input.placeholder}
            required={input.required}
            class="w-full border-b border-gray-300 pt-4 pb-2 placeholder:font-semibold focus:border-primary/70 focus:outline-none"
            pattern={input.pattern ? input.pattern : undefined}
            title={input.title}
          />
        </div>
      ))
    }
    <div class="col-span-full text-gray-900">
      <label for="message" class="mb-2 block text-xl font-bold text-primary"
        >Tu mensaje*</label
      >
      <textarea
        id="message"
        name="message"
        placeholder="Cuéntanos más sobre tu viaje ideal..."
        class="field-sizing-content min-h-32 w-full border-b border-gray-300 pt-4 pb-2 placeholder:font-semibold focus:border-primary/70 focus:outline-none"
        required></textarea>
    </div>
  </div>

  <!-- Honeypot: invisible para una persona, los bots lo rellenan.
       El nombre del campo queda fuera de los esquemas de autocompletado
       (navegador y gestores de contraseñas) para no descartar envíos reales. -->
  <div class="honeypot" aria-hidden="true">
    <label for="subject">No rellenes este campo</label>
    <input
      type="text"
      id="subject"
      name="subject"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="flex items-center gap-2">
    <input
      id="privacy"
      name="privacy"
      type="checkbox"
      class="size-4 accent-primary"
      required
    />
    <label for="privacy" class="block text-sm text-gray-600">
      Acepto la <a
        href="/politica-de-privacidad-y-cookies"
        class="text-primary hover:underline">política de privacidad</a
      > y el tratamiento de mis datos
    </label>
  </div>

  <div
    data-form-status
    role="status"
    aria-live="polite"
    hidden
    class="rounded-xl border px-4 py-3 text-sm leading-relaxed"
  >
    <span data-form-status-message></span>
    <span data-form-status-fallback hidden>
      También puedes escribirnos a <a
        href={`mailto:${company.email}`}
        class="font-semibold underline">{company.email}</a
      >.
    </span>
  </div>

  <button
    type="submit"
    class="w-full rounded-xl bg-primary px-4 py-3 font-bold text-white transition duration-300 hover:bg-primary/90"
  >
    Enviar Consulta
  </button>
</form>

<style>
  /* Fuera de pantalla en lugar de display:none: los bots que ignoran el CSS
     siguen viendo el campo en el DOM y lo rellenan. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  [data-form-status][data-state='success'] {
    border-color: #bbf7d0;
    background-color: #f0fdf4;
    color: #15803d;
  }

  [data-form-status][data-state='error'] {
    border-color: #fecaca;
    background-color: #fef2f2;
    color: #b91c1c;
  }
</style>

<script>
  import { PUBLIC_CONTACT_FORM_ENDPOINT } from 'astro:env/client';

  const CONTACT_ENDPOINT = PUBLIC_CONTACT_FORM_ENDPOINT;

  // Rellenar nombre, email, mensaje y aceptar la política lleva mucho más de
  // esto; por debajo del umbral el envío es automatizado.
  const MIN_FILL_MS = 2000;

  const SUCCESS_MESSAGE =
    '¡Mensaje enviado! Gracias por escribirnos, te responderemos lo antes posible. Echa un vistazo también a tu carpeta de spam.';
  const SERVER_ERROR_MESSAGE =
    'No hemos podido enviar tu mensaje. Inténtalo de nuevo en unos minutos.';
  const NETWORK_ERROR_MESSAGE =
    'Parece que no hay conexión. Compruébala e inténtalo de nuevo.';
  const REJECTED_MESSAGE =
    'No hemos podido verificar el envío. Vuelve a intentarlo o escríbenos directamente.';

  document
    .querySelectorAll<HTMLFormElement>('form[data-contact-form]')
    .forEach(form => {
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const message = form.querySelector<HTMLElement>(
        '[data-form-status-message]'
      );
      const fallback = form.querySelector<HTMLElement>(
        '[data-form-status-fallback]'
      );
      const submitButton = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]'
      );
      const honeypot = form.querySelector<HTMLInputElement>(
        'input[name="subject"]'
      );
      const renderedAt = Date.now();

      function showStatus(state: 'success' | 'error', text: string) {
        if (!status || !message) return;
        message.textContent = text;
        status.dataset.state = state;
        status.hidden = false;
        // El email de respaldo solo tiene sentido cuando el envío ha fallado
        if (fallback) fallback.hidden = state !== 'error';
      }

      function hideStatus() {
        if (!status) return;
        status.hidden = true;
        delete status.dataset.state;
      }

      form.addEventListener('submit', async event => {
        event.preventDefault();
        hideStatus();

        // Descarta el envío sin llegar al webhook: honeypot relleno o
        // formulario enviado demasiado rápido para ser humano.
        if (honeypot?.value || Date.now() - renderedAt < MIN_FILL_MS) {
          // Se vacía para que un reintento funcione: si un gestor de
          // contraseñas rellenó el honeypot, la persona no pierde el mensaje.
          if (honeypot) honeypot.value = '';
          showStatus('error', REJECTED_MESSAGE);
          return;
        }

        const data = Object.fromEntries(new FormData(form));
        // El honeypot no forma parte de la consulta.
        delete data.subject;
        const originalText = submitButton?.textContent || 'Enviar Consulta';

        // Deshabilitar botón para evitar envíos múltiples
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Enviando...';
        }

        try {
          const response = await fetch(CONTACT_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            // Solo vaciamos el formulario si se ha enviado: si falla, se conserva para reintentar.
            form.reset();
            showStatus('success', SUCCESS_MESSAGE);
          } else {
            const errorData = await response.json().catch(() => ({}));
            console.error('Error del servidor:', errorData);
            showStatus('error', SERVER_ERROR_MESSAGE);
          }
        } catch (error) {
          console.error('Error de red:', error);
          showStatus('error', NETWORK_ERROR_MESSAGE);
        } finally {
          // Rehabilitar botón
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        }
      });
    });
</script>
