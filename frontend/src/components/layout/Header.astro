---
import { Image } from 'astro:assets';
import logo from '@/assets/images/brand/logo.webp';
import Menu from '@/assets/icons/menu.svg';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const links = [
  { href: '/destinos', label: 'Destinos' },
  { href: '/blog', label: 'Blog' },
  { href: '/viajeros', label: 'Viajeros' },
  { href: '/sobre-nosotros', label: 'Sobre Nosotros' },
];

// A section link stays current on its detail pages (/blog/<slug> → Blog).
const getAriaCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`) ? 'page' : undefined;
---

<header
  class:list={[
    'fixed top-0 z-40 w-full',
    isHome
      ? 'text-white'
      : 'border-b border-gray-300 bg-white text-gray-800 shadow-md',
  ]}
>
  <div
    class="mx-auto flex items-center justify-between px-3 py-3 md:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center text-lg font-bold">
      {/* @ts-expect-error */}
      <Image
        src={logo}
        width={32}
        height={32}
        layout="none"
        densities={[1, 2, 3]}
        alt=""
        class="mr-2 size-8"
        loading="eager"
      />
      Kilómetros por Explorar
    </a>

    <nav
      aria-label="Navegación principal"
      class="hidden space-x-8 text-base lg:flex lg:items-center"
    >
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={getAriaCurrent(link.href)}
            class="hover:text-primary aria-[current=page]:font-bold aria-[current=page]:text-primary"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="rounded-xl bg-primary px-4 py-2 font-bold text-white transition duration-300 hover:bg-primary/90"
        >Planifica tu Viaje</a
      >
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="-m-2 rounded-lg p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current lg:hidden"
    >
      <Menu class="size-6" />
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    tabindex="-1"
    class="fixed inset-0 z-50 hidden flex-col items-center space-y-6 overflow-y-auto bg-white/95 px-3 py-4 text-center backdrop-blur-lg md:px-6 lg:hidden"
  >
    <div class="flex w-full items-center justify-between">
      <span class="text-lg font-bold text-gray-800">Menú</span>
      <button
        id="menu-close"
        type="button"
        aria-label="Cerrar menú de navegación"
        class="rounded-lg p-2 text-gray-600 hover:bg-gray-100 focus:ring-2 focus:ring-primary focus:outline-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          class="size-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav
      aria-label="Navegación móvil"
      class="flex flex-col items-center space-y-6"
    >
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={getAriaCurrent(link.href)}
            class="block py-3 text-xl text-gray-800 hover:text-primary aria-[current=page]:font-bold aria-[current=page]:text-primary"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="rounded-xl bg-primary px-6 py-3 text-xl font-bold text-white transition duration-300 hover:bg-primary/90"
        >Planifica tu Viaje</a
      >
    </nav>
  </div>
</header>

<script>
  // Mobile menu elements
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  function getFocusableElements() {
    if (!mobileMenu) return [];
    return Array.from(
      mobileMenu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function openMenu() {
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú de navegación');
    mobileMenu?.classList.remove('hidden');
    mobileMenu?.classList.add('flex');
    // The menu lives in the header's stacking context: lift it above the chat
    // launcher (z-50) while open, still below the cookie banner (z-60).
    mobileMenu?.closest('header')?.classList.replace('z-40', 'z-55');
    document.body.style.overflow = 'hidden';
    menuClose?.focus();
  }

  function closeMenu() {
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú de navegación');
    mobileMenu?.classList.add('hidden');
    mobileMenu?.classList.remove('flex');
    mobileMenu?.closest('header')?.classList.replace('z-55', 'z-40');
    document.body.style.overflow = '';
    menuToggle?.focus();
  }

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    isExpanded ? closeMenu() : openMenu();
  });

  menuClose?.addEventListener('click', closeMenu);

  // The menu only exists below lg: crossing the breakpoint while it is open
  // (e.g. rotating a tablet) would otherwise leave the page scroll-locked.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', e => {
    if (e.matches && menuToggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Close on Escape and trap focus within menu
  mobileMenu?.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }

    if (e.key === 'Tab') {
      const focusable = getFocusableElements();
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  });

  // Add background to header on scroll only on home page.
  if (window.location.pathname === '/') {
    const header = document.querySelector('header');

    function syncHeader() {
      if (window.scrollY > 0) {
        header?.classList.add(
          'bg-white',
          'text-gray-800',
          'border-b',
          'border-gray-300',
          'shadow-md'
        );
        header?.classList.remove('text-white');
      } else {
        header?.classList.remove(
          'bg-white',
          'border-b',
          'border-gray-300',
          'text-gray-800',
          'shadow-md'
        );
        header?.classList.add('text-white');
      }
    }

    syncHeader();
    document.addEventListener('scroll', syncHeader);
  }
</script>
