---
import { getCollection } from 'astro:content';
import BlogCard from '@/components/blog/BlogEntryCard.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getSortedPosts } from '@/utils/getSortedPosts';

const recentPosts = getSortedPosts(await getCollection('blog')).slice(0, 3);
---

<section class="mx-auto max-w-7xl px-4 py-16">
  <SectionHeading
    eyebrow="Consejos y guías"
    title="Explora nuestro blog"
    class="mb-8"
  />

  <div class="grid gap-6 md:grid-cols-3">
    {recentPosts.map(post => <BlogCard post={post} loading="lazy" />)}
  </div>

  <ArrowLink href="/blog" variant="button" class="mx-auto mt-12">
    <span>Ver todos los artículos</span>
  </ArrowLink>
</section>
