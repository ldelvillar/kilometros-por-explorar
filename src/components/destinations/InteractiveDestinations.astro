---
import { getCollection, type CollectionEntry } from 'astro:content';

import DestinationCard from '@/components/destinations/DestinationCard.astro';
import Magnifier from '@/assets/icons/magnifier.svg';

const allDestinations = await getCollection('destinations');

const categoryKeywords: Record<string, string> = {
  cultural: 'cultural culturales cultura',
  playa: 'playa playas costa',
  naturaleza: 'naturaleza natural montana',
  ciudad: 'ciudad ciudades urbano',
  barco: 'barco barcos crucero navegar',
  sorpresa: 'sorpresa pack packs',
};

const categoryTitles: { category: string; title: string }[] = [
  { category: 'cultural', title: 'Destinos culturales' },
  { category: 'playa', title: 'Playa' },
  { category: 'naturaleza', title: 'Naturaleza' },
  { category: 'barco', title: 'Viajes en barco' },
  { category: 'ciudad', title: 'Ciudades europeas' },
  { category: 'sorpresa', title: 'Packs sorpresa' },
];

const groups: {
  title: string;
  duplicate: boolean;
  destinations: CollectionEntry<'destinations'>[];
}[] = [
  {
    title: 'Destinos destacados',
    duplicate: true,
    destinations: allDestinations.filter(({ data }) => data.featured),
  },
  ...categoryTitles.map(({ category, title }) => ({
    title,
    duplicate: false,
    destinations: allDestinations.filter(
      ({ data }) => data.category === category
    ),
  })),
];

function getSearchText(destination: CollectionEntry<'destinations'>) {
  return [
    destination.data.name,
    destination.data.country ?? '',
    categoryKeywords[destination.data.category] ?? '',
    destination.data.shortDescription,
  ].join(' ');
}
---

<section class="mx-auto max-w-7xl px-4 pt-4 pb-12">
  <h2
    id="search-results-count"
    class="mb-6 text-2xl font-bold text-gray-900"
    hidden
  >
  </h2>

  <div id="destinations-grid" class="grid gap-6 md:grid-cols-3">
    {
      groups.map((group, groupIndex) => (
        <Fragment>
          <h2
            class:list={[
              'destination-heading col-span-full text-2xl font-bold text-gray-900',
              groupIndex > 0 && 'mt-6',
            ]}
          >
            {group.title}
          </h2>
          {group.destinations.map((destination, index) => (
            <div
              class="destination-item"
              data-category={destination.data.category}
              data-duplicate={group.duplicate ? '' : undefined}
              data-name={destination.data.name}
              data-search={getSearchText(destination)}
            >
              <DestinationCard
                destination={destination}
                loading={groupIndex === 0 && index < 3 ? 'eager' : 'lazy'}
                priority={groupIndex === 0 && index === 0}
              />
            </div>
          ))}
        </Fragment>
      ))
    }
  </div>

  <div
    id="no-results"
    class="mx-auto hidden max-w-[520px] px-4 pt-16 pb-12 text-center"
  >
    <div
      class="mx-auto mb-6 flex size-18 items-center justify-center rounded-full bg-primary/10"
    >
      <Magnifier class="size-8 text-primary" />
    </div>
    <h2 class="mb-2 text-2xl font-bold text-gray-900">
      Sin resultados para «<span id="no-results-query"></span>»
    </h2>
    <p class="leading-relaxed text-gray-500">
      No hemos encontrado destinos que coincidan con tu búsqueda. Prueba con
      otro término o explora todos nuestros destinos.
    </p>
  </div>
</section>

<script>
  // Initialize functionality when DOM is loaded
  document.addEventListener('DOMContentLoaded', function () {
    const chips = document.querySelectorAll('.hero-chip');
    const searchInput = document.getElementById(
      'hero-search'
    ) as HTMLInputElement | null;
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('.destination-heading')
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('.destination-item')
    );
    const grid = document.getElementById('destinations-grid');
    const resultsCount = document.getElementById('search-results-count');
    const noResults = document.getElementById('no-results');
    const noResultsQuery = document.getElementById('no-results-query');

    // Search ranking reorders the grid, so keep the authored order to restore.
    const authoredOrder = grid ? Array.from(grid.children) : [];

    // Notify the page (index.astro) so it can hide the CTA on the empty state.
    function setEmptyState(isEmpty: boolean) {
      document.dispatchEvent(
        new CustomEvent('destinos:emptychange', { detail: { empty: isEmpty } })
      );
    }

    let currentCategory = 'all';
    let isSearching = false;
    let searchTimeout: ReturnType<typeof setTimeout>;

    // Lowercase + strip accents.
    function normalize(str: string) {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '');
    }

    // Index the cards once, skipping the featured duplicates.
    const searchIndex = items
      .filter(node => !node.hasAttribute('data-duplicate'))
      .map(node => ({
        node,
        name: normalize(node.dataset.name || ''),
        haystack: normalize(node.dataset.search || ''),
      }));

    // Tokenize the query (every word must match) and rank name hits highest.
    function performSearch(query: string) {
      const tokens = normalize(query).split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return [];

      const scored = [];
      for (const entry of searchIndex) {
        // Require every token to appear somewhere in the searchable text.
        if (!tokens.every(token => entry.haystack.includes(token))) continue;

        // Score: name matches weigh most, with a bonus for prefix matches.
        let score = 0;
        for (const token of tokens) {
          if (entry.name.includes(token)) score += 10;
          if (entry.name.startsWith(token)) score += 5;
        }
        scored.push({ entry, score });
      }

      scored.sort(
        (a, b) => b.score - a.score || a.entry.name.localeCompare(b.entry.name)
      );
      return scored.map(item => item.entry);
    }

    // Category view.
    function showCategory(category: string) {
      currentCategory = category;
      const showAll = category === 'all';

      if (grid) authoredOrder.forEach(child => grid.appendChild(child));
      headings.forEach(heading => (heading.hidden = !showAll));
      items.forEach(node => {
        node.hidden = showAll
          ? false
          : node.dataset.category !== category ||
            node.hasAttribute('data-duplicate');
      });

      if (resultsCount) resultsCount.hidden = true;
      if (noResults) noResults.classList.add('hidden');
    }

    // Show the matching cards (hide the rest) in ranked order.
    function displaySearchResults(
      results: { node: HTMLElement }[],
      query: string
    ) {
      headings.forEach(heading => (heading.hidden = true));

      const matched = new Set(results.map(entry => entry.node));
      items.forEach(node => {
        node.hidden = !matched.has(node);
      });
      // Reorder so the highest-ranked matches come first.
      if (grid) results.forEach(entry => grid.appendChild(entry.node));

      const count = results.length;

      // Heading with the result count (hidden when there are no matches).
      if (resultsCount) {
        resultsCount.textContent =
          count === 1
            ? '1 destino encontrado'
            : `${count} destinos encontrados`;
        resultsCount.hidden = count === 0;
      }

      // Empty state shows the searched term and hides the page CTA.
      if (noResultsQuery) noResultsQuery.textContent = query;
      if (noResults) noResults.classList.toggle('hidden', count > 0);
      setEmptyState(count === 0);
    }

    // Highlight the pill that matches the active category.
    function setActiveChip(category: string) {
      chips.forEach(chip => {
        const active = chip.getAttribute('data-category') === category;
        chip.setAttribute('data-active', active ? 'true' : 'false');
      });
    }

    // Category pill navigation.
    chips.forEach(chip => {
      chip.addEventListener('click', function (this: HTMLElement) {
        if (isSearching && searchInput) {
          // Clear search when switching categories
          searchInput.value = '';
          isSearching = false;
          syncUrl(null);
          setEmptyState(false);
        }

        const category = this.getAttribute('data-category');
        if (category) {
          setActiveChip(category);
          showCategory(category);
        }
      });
    });

    // Reflect the active query in the URL (?q=) without adding history
    // entries, so searches are shareable and survive a reload.
    function syncUrl(query: string | null) {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    }

    // Run a search and show the results (no category is active while searching).
    function runSearch(query: string) {
      isSearching = true;
      chips.forEach(chip => chip.setAttribute('data-active', 'false'));
      displaySearchResults(performSearch(query), query);
      syncUrl(query);
    }

    // Restore the last selected category when the search is emptied.
    function clearSearch() {
      isSearching = false;
      setActiveChip(currentCategory);
      showCategory(currentCategory);
      syncUrl(null);
      setEmptyState(false);
    }

    // Search functionality
    if (searchInput) {
      // Debounced live search as the user types.
      searchInput.addEventListener('input', function () {
        const query = this.value.trim();
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          if (query.length >= 2) runSearch(query);
          else clearSearch();
        }, 300);
      });

      // "Buscar" button + Enter run the search immediately (skip the debounce).
      const searchButton = document.getElementById('hero-search-btn');
      const submitSearch = () => {
        const query = searchInput.value.trim();
        clearTimeout(searchTimeout);
        if (query.length >= 2) runSearch(query);
        else clearSearch();
        searchInput.focus();
      };
      if (searchButton) searchButton.addEventListener('click', submitSearch);
      searchInput.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          event.preventDefault();
          submitSearch();
        }
      });
    }

    // Pre-fill and run search from the ?q= URL parameter
    const initialQuery = new URLSearchParams(window.location.search)
      .get('q')
      ?.trim();
    if (searchInput && initialQuery && initialQuery.length >= 2) {
      searchInput.value = initialQuery;
      runSearch(initialQuery);
    }
  });
</script>

<style>
  .destination-item {
    display: contents;
  }

  .destination-item[hidden] {
    display: none;
  }
</style>
