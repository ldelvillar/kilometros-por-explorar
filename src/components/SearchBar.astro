---
import Magnifier from '@/assets/icons/magnifier.svg';

interface Props {
  id: string;
  buttonId: string;
  placeholder: string;
  label: string;
  class?: string;
}

const {
  id,
  buttonId,
  placeholder,
  label,
  class: className,
} = Astro.props as Props;
---

<div class:list={['relative', className]}>
  <Magnifier
    class="pointer-events-none absolute top-1/2 left-5 size-[22px] -translate-y-1/2 text-gray-400"
  />
  <input
    id={id}
    type="text"
    aria-label={label}
    placeholder={placeholder}
    class="w-full rounded-full border border-gray-200 bg-white py-[18px] pr-[140px] pl-[54px] font-display text-[17px] text-gray-800 shadow-[0_8px_24px_-16px_rgba(15,23,42,0.3)] transition-all duration-200 outline-none placeholder:text-gray-400 focus:border-primary focus:shadow-[0_0_0_3px_rgba(18,163,237,0.2)]"
  />
  <button
    type="button"
    id={buttonId}
    class="absolute top-1/2 right-2 -translate-y-1/2 cursor-pointer rounded-full bg-primary px-6 py-[11px] text-[15px] font-bold text-white transition-colors duration-200 hover:bg-primary/90"
  >
    Buscar
  </button>
</div>
