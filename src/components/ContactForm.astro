---
import { SITE_CONFIG } from '@/config/site';

interface InputsData {
  question: string;
  type: 'text' | 'email' | 'tel' | 'textarea';
  id: string;
  placeholder: string;
  pattern?: string;
  required: boolean;
}

const INPUTS: InputsData[] = [
  {
    question: 'Nombre*',
    type: 'text',
    id: 'name',
    placeholder: 'Introduce tu nombre',
    required: true,
  },
  {
    question: 'Apellido',
    type: 'text',
    id: 'surname',
    placeholder: 'Introduce tu apellido',
    required: false,
  },
  {
    question: 'Email*',
    type: 'email',
    id: 'email',
    placeholder: 'Introduce tu email',
    required: true,
  },
  {
    question: 'Teléfono',
    type: 'tel',
    id: 'phone',
    placeholder: 'Introduce tu teléfono',
    pattern: '^(\+?\d{1,3}\s*)?(\s*\d\s*){9}$',
    required: false,
  },
];

const { company } = SITE_CONFIG;
---

<form class="space-y-6" autocomplete="on" data-contact-form>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      INPUTS.map(input => (
        <div
          class={`text-gray-900 ${input.type === 'textarea' ? 'col-span-full' : ''}`}
        >
          <label
            for={input.id}
            class="mb-2 block text-xl font-bold text-primary"
          >
            {input.question}
          </label>

          <input
            type={input.type}
            id={input.id}
            name={input.id}
            placeholder={input.placeholder}
            required={input.required}
            class="w-full border-b border-gray-300 pt-4 pb-2 placeholder:font-semibold focus:border-primary/70 focus:outline-none"
            pattern={input.pattern ? input.pattern : undefined}
          />
        </div>
      ))
    }
    <div class="col-span-full text-gray-900">
      <label for="message" class="mb-2 block text-xl font-bold text-primary"
        >Tu mensaje*</label
      >
      <textarea
        id="message"
        name="message"
        placeholder="Cuéntanos más sobre tu viaje ideal..."
        class="field-sizing-content min-h-32 w-full border-b border-gray-300 pt-4 pb-2 placeholder:font-semibold focus:border-primary/70 focus:outline-none"
        required></textarea>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <input
      id="privacy"
      name="privacy"
      type="checkbox"
      class="size-4 accent-primary"
      required
    />
    <label for="privacy" class="block text-sm text-gray-600">
      Acepto la <a
        href="/politica-de-privacidad-y-cookies"
        class="text-primary hover:underline">política de privacidad</a
      > y el tratamiento de mis datos
    </label>
  </div>

  <div
    data-form-status
    role="status"
    aria-live="polite"
    hidden
    class="rounded-xl border px-4 py-3 text-sm leading-relaxed"
  >
    <span data-form-status-message></span>
    <span data-form-status-fallback hidden>
      También puedes escribirnos a <a
        href={`mailto:${company.email}`}
        class="font-semibold underline">{company.email}</a
      >.
    </span>
  </div>

  <button
    type="submit"
    class="w-full rounded-xl bg-primary px-4 py-3 font-bold text-white transition duration-300 hover:bg-primary/90"
  >
    Enviar Consulta
  </button>
</form>

<style>
  [data-form-status][data-state='success'] {
    border-color: #bbf7d0;
    background-color: #f0fdf4;
    color: #15803d;
  }

  [data-form-status][data-state='error'] {
    border-color: #fecaca;
    background-color: #fef2f2;
    color: #b91c1c;
  }
</style>

<script>
  const CONTACT_ENDPOINT = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;

  const SUCCESS_MESSAGE =
    '¡Mensaje enviado! Gracias por escribirnos, te responderemos lo antes posible. Echa un vistazo también a tu carpeta de spam.';
  const SERVER_ERROR_MESSAGE =
    'No hemos podido enviar tu mensaje. Inténtalo de nuevo en unos minutos.';
  const NETWORK_ERROR_MESSAGE =
    'Parece que no hay conexión. Compruébala e inténtalo de nuevo.';

  document
    .querySelectorAll<HTMLFormElement>('form[data-contact-form]')
    .forEach(form => {
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const message = form.querySelector<HTMLElement>(
        '[data-form-status-message]'
      );
      const fallback = form.querySelector<HTMLElement>(
        '[data-form-status-fallback]'
      );
      const submitButton = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]'
      );

      function showStatus(state: 'success' | 'error', text: string) {
        if (!status || !message) return;
        message.textContent = text;
        status.dataset.state = state;
        status.hidden = false;
        // El email de respaldo solo tiene sentido cuando el envío ha fallado
        if (fallback) fallback.hidden = state !== 'error';
      }

      function hideStatus() {
        if (!status) return;
        status.hidden = true;
        delete status.dataset.state;
      }

      form.addEventListener('submit', async event => {
        event.preventDefault();
        hideStatus();

        const data = Object.fromEntries(new FormData(form));
        const originalText = submitButton?.textContent || 'Enviar Consulta';

        // Deshabilitar botón para evitar envíos múltiples
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Enviando...';
        }

        try {
          const response = await fetch(CONTACT_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            // Solo vaciamos el formulario si se ha enviado: si falla, se conserva para reintentar.
            form.reset();
            showStatus('success', SUCCESS_MESSAGE);
          } else {
            const errorData = await response.json().catch(() => ({}));
            console.error('Error del servidor:', errorData);
            showStatus('error', SERVER_ERROR_MESSAGE);
          }
        } catch (error) {
          console.error('Error de red:', error);
          showStatus('error', NETWORK_ERROR_MESSAGE);
        } finally {
          // Rehabilitar botón
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        }
      });
    });
</script>
