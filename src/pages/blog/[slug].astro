---
import { Image } from 'astro:assets';
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/Cta.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getCombinedSchema,
  getFAQSchema,
  getWebPageSchema,
  type BreadcrumbItem,
} from '@/config/schemas';
import BlogCard from '@/components/blog/BlogEntryCard.astro';
import ArticleDestinations from '@/components/blog/ArticleDestinations.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import Calendar from '@/assets/icons/calendar.svg';
import Clock from '@/assets/icons/clock.svg';
import { getReadingTime } from '@/utils/getReadingTime';
import { getPageTitle } from '@/utils/getPageTitle';
import { getSortedPosts } from '@/utils/getSortedPosts';
import '@/styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getCollection('blog');

  // Comprobamos aquí todos los destinos: un id mal escrito debe romper el build
  for (const post of posts) {
    for (const ref of post.data.destinations) {
      if (!(await getEntry(ref))) {
        throw new Error(
          `El artículo "${post.id}" referencia el destino inexistente "${ref.id}".`
        );
      }
    }
  }

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);

const destinationIds = new Set(post.data.destinations.map(({ id }) => id));
const relatedPosts = await getCollection('blog', ({ data }) => {
  return data.destinations.some(({ id }) => destinationIds.has(id));
});

const sortedRelatedPosts = getSortedPosts(
  relatedPosts.filter(p => p.id !== post.id)
);

const title = getPageTitle(post.data.title);
const description = post.data.description;
const pathname = Astro.url.pathname;

const breadcrumbItems: BreadcrumbItem[] = [
  { name: 'Inicio', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.data.title },
];

const mainDestinationRef = post.data.destinations[0];
const mainDestination = mainDestinationRef
  ? (await getEntry(mainDestinationRef))?.data.name
  : undefined;

const pageSchema = getWebPageSchema(title, description, pathname, true);
const articleSchema = getArticleSchema(
  post.data.title,
  description,
  pathname,
  post.data.date.toISOString(),
  post.data.updatedDate?.toISOString(),
  post.data.image.src,
  mainDestination,
  readingTime
);

const faqSchema = getFAQSchema(post.data.faqs, pathname);

const schema = getCombinedSchema(
  pageSchema,
  articleSchema,
  getBreadcrumbSchema(breadcrumbItems, pathname),
  faqSchema
);
---

<Layout
  title={title}
  description={description}
  schema={schema}
  image={post.data.image}
  imageAlt={post.data.title}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.date).toISOString()}
>
  <main id="main" class="bg-white pt-20">
    <!-- Breadcrumbs -->
    <div class="mx-auto max-w-5xl py-4">
      <Breadcrumbs items={breadcrumbItems} class="px-2 md:px-0" />
    </div>

    <!-- Hero image -->
    <div class="mx-auto w-full max-w-5xl">
      <Image
        src={post.data.image}
        alt={post.data.title}
        class="h-[240px] w-full object-cover md:h-[420px]"
        widths={[640, 1024, 1536, 1920]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading="eager"
      />
    </div>

    <!-- Content -->
    <div
      class="relative z-10 mx-auto -mt-12 max-w-4xl bg-white px-4 sm:px-6 md:-mt-16 lg:-mt-20 lg:px-8"
    >
      <!-- Header -->
      <header class="mb-8 pt-8 text-center md:pt-12">
        <div
          class="mb-4 flex flex-wrap items-center justify-center gap-4 text-neutral-600"
        >
          <span class="inline-flex items-center gap-1.5">
            <Calendar class="size-4.5 text-primary" />
            <time datetime={post.data.date.toISOString()}>
              {
                post.data.date.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="size-4.5 text-primary" />
            <span>{readingTime} min de lectura</span>
          </span>
          {
            post.data.updatedDate && (
              <span class="inline-flex items-center gap-2 rounded-full bg-[#00a055]/9 px-3.5 py-[5px] text-sm font-bold text-[#00733d]">
                <span
                  class="size-[5px] shrink-0 rounded-full bg-[#00a055]"
                  aria-hidden="true"
                />
                Actualizado
                <time datetime={post.data.updatedDate.toISOString()}>
                  {post.data.updatedDate.toLocaleDateString('es-ES', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
              </span>
            )
          }
        </div>
        <h1 class="text-3xl font-bold text-gray-900 md:text-4xl">
          {post.data.title}
        </h1>
        <ArticleDestinations post={post} class="mt-6" />
      </header>

      <hr class="my-8 border-t border-gray-300 lg:my-16" />

      <!-- Rail lateral pegajoso del índice (>=1440px) -->
      <nav class="toc-rail" aria-label="Índice del artículo" aria-hidden="true">
        <p class="toc-rail-eyebrow">En este artículo</p>
        <div class="toc-rail-track">
          <span class="toc-rail-fill"></span>
        </div>
      </nav>

      <!-- Article -->
      <article class="mx-auto prose mb-12 max-w-[800px] lg:prose-lg">
        <Content />
      </article>

      <hr class="my-8 border-t border-gray-300 lg:my-16" />

      <!-- FAQs -->
      <section class="mx-auto mb-16 max-w-[800px]">
        <SectionHeading
          eyebrow="Resolvemos tus dudas"
          title="Preguntas frecuentes"
          class="mb-8"
        />
        <FaqAccordion faqs={post.data.faqs} />
      </section>
    </div>

    <!-- Related articles -->
    {
      sortedRelatedPosts.length > 0 && (
        <div class="mx-auto mb-16 max-w-4xl px-4 sm:px-6 lg:px-8">
          <SectionHeading
            eyebrow="Sigue explorando"
            title="Artículos relacionados"
            class="mb-8"
          />
          <div class="grid gap-8 md:grid-cols-2">
            {sortedRelatedPosts.map(post => (
              <BlogCard post={post} loading="lazy" />
            ))}
          </div>
        </div>
      )
    }
    <CTA />
  </main>

  <script>
    const toc = document.querySelector<HTMLElement>('.toc');
    const article = document.querySelector<HTMLElement>('article.prose');
    const rail = document.querySelector<HTMLElement>('.toc-rail');
    const track = rail?.querySelector<HTMLElement>('.toc-rail-track');
    const fill = rail?.querySelector<HTMLElement>('.toc-rail-fill');

    if (toc && article && rail && track && fill) {
      const items = Array.from(
        toc.querySelectorAll<HTMLAnchorElement>('.toc-row')
      ).map(row => {
        const item = document.createElement('a');
        item.className = 'toc-rail-item';
        item.href = row.getAttribute('href') ?? '#';
        item.textContent = row.lastChild?.textContent?.trim() ?? '';
        track.appendChild(item);
        return item;
      });

      const update = () => {
        const visible =
          toc.getBoundingClientRect().bottom < 72 &&
          article.getBoundingClientRect().bottom > 200;
        rail.classList.toggle('on', visible);
        rail.setAttribute('aria-hidden', String(!visible));

        let current = items[0];
        for (const item of items) {
          const target = document.getElementById(
            (item.getAttribute('href') ?? '').slice(1)
          );
          if (target && target.getBoundingClientRect().top <= 140)
            current = item;
        }

        for (const item of items) {
          const isActive = item === current;
          item.classList.toggle('on', isActive);
          item.tabIndex = visible ? 0 : -1;
        }

        if (current) {
          fill.style.top = `${current.offsetTop + 6}px`;
          fill.style.height = `${current.offsetHeight - 12}px`;
        }
      };

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }
  </script>
</Layout>
